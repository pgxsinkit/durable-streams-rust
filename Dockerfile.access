# syntax=docker/dockerfile:1

FROM rust:1.96.0-bookworm AS build
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN cargo build --release --locked --bin durable-streams-access

FROM gcr.io/distroless/cc-debian12:nonroot AS runtime
COPY --from=build /app/target/release/durable-streams-access /usr/local/bin/durable-streams-access
USER nonroot
EXPOSE 8443
ENTRYPOINT ["/usr/local/bin/durable-streams-access"]
